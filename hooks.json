{
  "agy-ensemble-telemetry": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node scripts/hook-handler.mjs",
        "timeout": 10
      }
    ],
    "PostToolUse": [
      {
        "matcher": "run_command|write_file|edit_file|replace_file_content|multi_replace_file_content|read_file|view_file|send_message|invoke_subagent|schedule|update_steps|update_focus|ensemble_.*",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hook-handler.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "agy-ensemble-gitleaks-guard": {
    "enabled": false,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hook-handler.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
